if(BUILD_TESTING)
    add_test_executable(agc_timeline_format_tests tests/Timeline.cpp Execution/src/ArchB/CheapClock.cpp)
    target_include_directories(agc_timeline_format_tests PRIVATE ${LIBS_INCLUDE_DIR})
    target_link_libraries(agc_timeline_format_tests PRIVATE libc)
    configure_windows_unwind(agc_timeline_format_tests)
    add_test(NAME agc_timeline_format COMMAND ${CMAKE_COMMAND} -E env --unset=APS5_TIMELINE $<TARGET_FILE:agc_timeline_format_tests>)
    add_test(NAME agc_timeline_enabled COMMAND agc_timeline_format_tests)
    set_tests_properties(agc_timeline_format agc_timeline_enabled PROPERTIES TIMEOUT 20)
    set_tests_properties(agc_timeline_enabled PROPERTIES ENVIRONMENT "APS5_TIMELINE=${CMAKE_CURRENT_BINARY_DIR}/timeline-format")
    if(WIN32)
        set_tests_properties(agc_timeline_format agc_timeline_enabled PROPERTIES ENVIRONMENT_MODIFICATION
                "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
    endif()
endif()
