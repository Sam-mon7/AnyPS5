if(BUILD_TESTING)
    foreach(partialScenario IN ITEMS storage depth depthtwo cpu remap two own)
        foreach(partialMode IN ITEMS off on verify)
            set(partialName agc_driver_dispatch_partial_reproof_${partialScenario}_${partialMode})
            add_test(NAME ${partialName} COMMAND agc_driver_dispatch_partial_reproof_tests ${partialScenario})
            set(partialEnabled 1)
            if(partialMode STREQUAL "off")
                set(partialEnabled 0)
            endif()
            set(partialEnvironment "ANYPS5_NO_SHADER_CACHE=1;APS5_ARCHB_DISPATCH_PARTIAL_REPROOF=${partialEnabled};APS5_NO_OPPORTUNISTIC_REAP=1;APS5_ARCHB_C_DRAW_REPLAY_STEPS=1")
            if(partialMode STREQUAL "verify")
                list(APPEND partialEnvironment "APS5_VERIFY_DISPATCH_PARTIAL_REPROOF=1" "APS5_VERIFY_DISPATCH_PARTIAL_REPROOF_EVERY=1")
            endif()
            set_tests_properties(${partialName} PROPERTIES ENVIRONMENT "${partialEnvironment}" SKIP_RETURN_CODE 77 TIMEOUT 30 FAIL_REGULAR_EXPRESSION "VUID-;Validation Error;VERIFY mismatch;was not found but was requested by env var VK_INSTANCE_LAYERS")
            if(WIN32)
                set_tests_properties(${partialName} PROPERTIES ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
            endif()
        endforeach()
    endforeach()
endif()
