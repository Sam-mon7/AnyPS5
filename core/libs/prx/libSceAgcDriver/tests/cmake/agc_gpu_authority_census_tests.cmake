add_test_executable(agc_gpu_authority_census_tests EXCLUDE_FROM_ALL tests/GpuAuthorityCensus.cpp)
target_include_directories(agc_gpu_authority_census_tests PRIVATE ${LIBS_INCLUDE_DIR})
target_link_libraries(agc_gpu_authority_census_tests PRIVATE libSceAgcDriver)
set_target_properties(agc_gpu_authority_census_tests PROPERTIES CXX_EXTENSIONS OFF)
configure_windows_unwind(agc_gpu_authority_census_tests)

if(BUILD_TESTING)
    set_target_properties(agc_gpu_authority_census_tests PROPERTIES EXCLUDE_FROM_ALL OFF)
    foreach(mode IN ITEMS on off)
        add_test(NAME agc_gpu_authority_census_${mode} COMMAND agc_gpu_authority_census_tests)
        set_tests_properties(agc_gpu_authority_census_${mode} PROPERTIES TIMEOUT 30)
        if(WIN32)
            set_tests_properties(agc_gpu_authority_census_${mode} PROPERTIES ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
        endif()
    endforeach()
    set_tests_properties(agc_gpu_authority_census_on PROPERTIES ENVIRONMENT "APS5_ARCHB_GPU_AUTHORITY_CENSUS=1;APS5_ARCHB_GPU_AUTHORITY_CENSUS_VERIFY=1;APS5_GPU_AUTHORITY_CENSUS_FILE=census-on.csv")
    set_tests_properties(agc_gpu_authority_census_off PROPERTIES ENVIRONMENT "APS5_ARCHB_GPU_AUTHORITY_CENSUS=0;APS5_GPU_AUTHORITY_CENSUS_FILE=census-off.csv")
endif()
