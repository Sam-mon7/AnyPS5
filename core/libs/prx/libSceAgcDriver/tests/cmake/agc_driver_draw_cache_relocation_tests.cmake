if(BUILD_TESTING)
    foreach(rawMode IN ITEMS hit relocated nested verify pending)
        set(rawTest agc_driver_draw_cache_raw_first_${rawMode})
        if(rawMode STREQUAL "relocated")
            add_test(NAME ${rawTest} COMMAND agc_driver_draw_cache_relocation_tests --raw-relocated)
        elseif(rawMode STREQUAL "pending")
            add_test(NAME ${rawTest} COMMAND agc_driver_draw_cache_relocation_tests --raw-pending)
        elseif(rawMode STREQUAL "nested")
            add_test(NAME ${rawTest} COMMAND agc_driver_draw_cache_relocation_tests --nested)
        else()
            add_test(NAME ${rawTest} COMMAND agc_driver_draw_cache_relocation_tests --raw-first)
        endif()
        set_tests_properties(${rawTest} PROPERTIES ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1;APS5_ARCHB_DRAW_RAW_KEY_FIRST=1;APS5_ARCHB_FIX_DRAW_RELOC_NESTED=1" SKIP_RETURN_CODE 77 TIMEOUT 30 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
        if(rawMode STREQUAL "pending")
            set_property(TEST ${rawTest} APPEND PROPERTY ENVIRONMENT "APS5_DRAW_PIPELINE=1;APS5_PIPELINED_DRAWS=32")
        endif()
        if(rawMode STREQUAL "verify" OR rawMode STREQUAL "nested" OR rawMode STREQUAL "relocated")
            set_property(TEST ${rawTest} APPEND PROPERTY ENVIRONMENT "APS5_ARCHB_DRAW_RAW_KEY_FIRST_VERIFY=1")
        endif()
        if(WIN32)
            set_tests_properties(${rawTest} PROPERTIES ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
        endif()
    endforeach()
endif()
