if(BUILD_TESTING)
    set(gatherImagesEnvironment "ANYPS5_NO_SHADER_CACHE=1;APS5_ARCHB_DISPATCH_GATHER_SHADOW=1;APS5_DISPATCH_GATHER_SHADOW_STRICT=1;APS5_ARCHB_RECORDER=1")
    set_tests_properties(agc_driver_dispatch_gather_images PROPERTIES ENVIRONMENT "${gatherImagesEnvironment};APS5_PIPELINED_DRAWS=0" TIMEOUT 30 FAIL_REGULAR_EXPRESSION "FATAL:;VUID-")
    foreach(gatherImagesCase IN ITEMS merged-control resource-control writer writer-sampled writer-mutation writer-variants writer-variants-full writer-variants-batch writer-multiunit writer-mips writer-array writer-array-base storage-read image-mutation sampler-mutation pending-writer pending-writer-twice registered-identity backing-rebuild)
        string(REPLACE "-" "_" gatherImagesSuffix ${gatherImagesCase})
        set(gatherImagesTest agc_driver_dispatch_gather_images_${gatherImagesSuffix})
        add_test(NAME ${gatherImagesTest} COMMAND agc_driver_dispatch_gather_images_tests --${gatherImagesCase})
        set_tests_properties(${gatherImagesTest} PROPERTIES ENVIRONMENT "${gatherImagesEnvironment};APS5_PIPELINED_DRAWS=0" TIMEOUT 30 SKIP_RETURN_CODE 77 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}" FAIL_REGULAR_EXPRESSION "FATAL:;VUID-")
        if(WIN32)
            set_property(TEST ${gatherImagesTest} APPEND PROPERTY ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
        endif()
    endforeach()
    add_test(NAME agc_driver_dispatch_gather_images_writer_variants_pipeline COMMAND agc_driver_dispatch_gather_images_tests --writer-variants-batch)
    set_tests_properties(agc_driver_dispatch_gather_images_writer_variants_pipeline PROPERTIES ENVIRONMENT "${gatherImagesEnvironment};APS5_PIPELINED_DRAWS=1" TIMEOUT 30 SKIP_RETURN_CODE 77 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}" FAIL_REGULAR_EXPRESSION "FATAL:;VUID-")
    if(WIN32)
        set_property(TEST agc_driver_dispatch_gather_images_writer_variants_pipeline APPEND PROPERTY ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
    endif()
    foreach(gatherWriterEpochCase IN ITEMS writer-epochs writer-epochs-suppressed)
        string(REPLACE "-" "_" gatherWriterEpochSuffix ${gatherWriterEpochCase})
        set(gatherWriterEpochTest agc_driver_dispatch_gather_images_${gatherWriterEpochSuffix})
        add_test(NAME ${gatherWriterEpochTest} COMMAND agc_driver_dispatch_gather_images_tests --${gatherWriterEpochCase})
        set_tests_properties(${gatherWriterEpochTest} PROPERTIES ENVIRONMENT "${gatherImagesEnvironment};APS5_PIPELINED_DRAWS=0;APS5_ARCHB_C_TARGET_CENSUS=1" TIMEOUT 30 SKIP_RETURN_CODE 77 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}" FAIL_REGULAR_EXPRESSION "FATAL:;VUID-")
        if(WIN32)
            set_property(TEST ${gatherWriterEpochTest} APPEND PROPERTY ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
        endif()
    endforeach()
    foreach(gatherWriterMode IN ITEMS eager no_cache)
        if(gatherWriterMode STREQUAL "eager")
            set(gatherWriterModeEnvironment "APS5_EAGER_WRITEBACK=1")
        else()
            set(gatherWriterModeEnvironment "APS5_NO_TEXTURE_CACHE=1")
        endif()
        set(gatherWriterModeTest agc_driver_dispatch_gather_images_writer_${gatherWriterMode})
        add_test(NAME ${gatherWriterModeTest} COMMAND agc_driver_dispatch_gather_images_tests --writer-mode)
        set_tests_properties(${gatherWriterModeTest} PROPERTIES ENVIRONMENT "${gatherImagesEnvironment};APS5_PIPELINED_DRAWS=0;${gatherWriterModeEnvironment}" TIMEOUT 30 SKIP_RETURN_CODE 77 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}" FAIL_REGULAR_EXPRESSION "FATAL:;VUID-")
        if(WIN32)
            set_property(TEST ${gatherWriterModeTest} APPEND PROPERTY ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
        endif()
    endforeach()
    add_test(NAME agc_driver_dispatch_gather_images_off COMMAND agc_driver_dispatch_gather_images_tests --off)
    set_tests_properties(agc_driver_dispatch_gather_images_off PROPERTIES ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1;APS5_ARCHB_DISPATCH_GATHER_SHADOW=0;APS5_PIPELINED_DRAWS=0" TIMEOUT 30 SKIP_RETURN_CODE 77 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}" FAIL_REGULAR_EXPRESSION "FATAL:;VUID-")
    if(WIN32)
        set_property(TEST agc_driver_dispatch_gather_images_off APPEND PROPERTY ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
    endif()
endif()
