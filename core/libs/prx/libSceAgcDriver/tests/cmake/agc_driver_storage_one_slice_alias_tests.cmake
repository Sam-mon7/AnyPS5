if(BUILD_TESTING)
    foreach(firstAccessMode IN ITEMS profile off)
        set(firstAccessTest agc_driver_foreign_pending_first_access_${firstAccessMode})
        add_test(NAME ${firstAccessTest} COMMAND agc_driver_storage_one_slice_alias_tests --foreign-first-access)
        set_tests_properties(${firstAccessTest} PROPERTIES ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1;APS5_PIPELINED_DRAWS=0;APS5_BLOCK_WRITEBACK_EACH=1" SKIP_RETURN_CODE 77 TIMEOUT 30 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
        set_property(TEST ${firstAccessTest} APPEND PROPERTY ENVIRONMENT_MODIFICATION "APS5_NO_BLOCK_TRACKING=unset:;APS5_NO_RESIDENT_TARGETS=unset:;APS5_NO_FILL_CLEAR=unset:;APS5_EAGER_WRITEBACK=unset:;APS5_NO_TEXTURE_CACHE=unset:")
        if(firstAccessMode STREQUAL "profile")
            set_property(TEST ${firstAccessTest} APPEND PROPERTY ENVIRONMENT "APS5_PROFILE_DRAW=1")
        else()
            set_property(TEST ${firstAccessTest} APPEND PROPERTY ENVIRONMENT_MODIFICATION "APS5_PROFILE_DRAW=unset:")
        endif()
        if(WIN32)
            set_property(TEST ${firstAccessTest} APPEND PROPERTY ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
        endif()
    endforeach()
    foreach(pendingAliasMode IN ITEMS on off profile no_alias layer_tracking)
        set(pendingAliasTest agc_driver_pending_target_alias_${pendingAliasMode})
        add_test(NAME ${pendingAliasTest} COMMAND agc_driver_storage_one_slice_alias_tests --pending-target)
        set_tests_properties(${pendingAliasTest} PROPERTIES ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1;APS5_PIPELINED_DRAWS=0" SKIP_RETURN_CODE 77 TIMEOUT 30 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
        if(NOT pendingAliasMode STREQUAL "off")
            set_property(TEST ${pendingAliasTest} APPEND PROPERTY ENVIRONMENT "APS5_PENDING_ALIAS_BORROW=1")
        endif()
        if(pendingAliasMode STREQUAL "profile")
            set_property(TEST ${pendingAliasTest} APPEND PROPERTY ENVIRONMENT "APS5_PROFILE_DRAW=1")
        elseif(pendingAliasMode STREQUAL "no_alias")
            set_property(TEST ${pendingAliasTest} APPEND PROPERTY ENVIRONMENT "APS5_NO_ALIAS_BORROW=1")
        elseif(pendingAliasMode STREQUAL "layer_tracking")
            set_property(TEST ${pendingAliasTest} APPEND PROPERTY ENVIRONMENT "APS5_NO_BLOCK_TRACKING=1")
        endif()
        if(WIN32)
            set_tests_properties(${pendingAliasTest} PROPERTIES ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
        endif()
        if(pendingAliasMode STREQUAL "off")
            set_property(TEST ${pendingAliasTest} APPEND PROPERTY ENVIRONMENT_MODIFICATION "APS5_PENDING_ALIAS_BORROW=unset:")
        endif()
        if(NOT pendingAliasMode STREQUAL "no_alias")
            set_property(TEST ${pendingAliasTest} APPEND PROPERTY ENVIRONMENT_MODIFICATION "APS5_NO_ALIAS_BORROW=unset:")
        endif()
        if(NOT pendingAliasMode STREQUAL "layer_tracking")
            set_property(TEST ${pendingAliasTest} APPEND PROPERTY ENVIRONMENT_MODIFICATION "APS5_NO_BLOCK_TRACKING=unset:")
        endif()
    endforeach()
endif()
