if(BUILD_TESTING)
    foreach(drawMovedMode IN ITEMS on off profile)
        set(drawMovedTest agc_driver_draw_moved_recipes_${drawMovedMode})
        add_test(NAME ${drawMovedTest} COMMAND agc_driver_depth_bias_per_face_tests --moved-recipes)
        set_tests_properties(${drawMovedTest} PROPERTIES ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1;APS5_PIPELINED_DRAWS=0" SKIP_RETURN_CODE 77 TIMEOUT 30 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
        if(drawMovedMode STREQUAL "off")
            set_property(TEST ${drawMovedTest} APPEND PROPERTY ENVIRONMENT "APS5_NO_DRAW_MOVED_RECIPES=1")
        elseif(drawMovedMode STREQUAL "profile")
            set_property(TEST ${drawMovedTest} APPEND PROPERTY ENVIRONMENT "APS5_PROFILE_DRAW=1")
        endif()
        if(WIN32)
            set_tests_properties(${drawMovedTest} PROPERTIES ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
        endif()
    endforeach()
endif()
