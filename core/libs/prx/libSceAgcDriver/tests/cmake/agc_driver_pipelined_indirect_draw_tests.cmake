if(BUILD_TESTING)
    foreach(agcIndirectArgsMode IN ITEMS gpu_args_kept gpu_args_drain cpu_args_drain cpu_args_drain_off pipelined_cut)
        set(agcIndirectArgsTest agc_driver_pipe_q0_indirect_${agcIndirectArgsMode})
        if(agcIndirectArgsMode STREQUAL "pipelined_cut")
            add_test(NAME ${agcIndirectArgsTest} COMMAND agc_driver_pipelined_indirect_draw_tests)
        elseif(agcIndirectArgsMode MATCHES "^gpu")
            add_test(NAME ${agcIndirectArgsTest} COMMAND agc_driver_pipelined_indirect_draw_tests --gpu-args-written)
        else()
            add_test(NAME ${agcIndirectArgsTest} COMMAND agc_driver_pipelined_indirect_draw_tests --cpu-args-written)
        endif()
        set_tests_properties(${agcIndirectArgsTest} PROPERTIES ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1;APS5_ARCHB_PIPE_Q0_COMMITTER=1;APS5_PROFILE_DRAW=1" SKIP_RETURN_CODE 77 TIMEOUT 60 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
        if(agcIndirectArgsMode STREQUAL "gpu_args_drain" OR agcIndirectArgsMode STREQUAL "cpu_args_drain_off")
            set_property(TEST ${agcIndirectArgsTest} APPEND PROPERTY ENVIRONMENT_MODIFICATION "APS5_PIPELINED_DRAWS=unset:" "APS5_ARCHB_PIPE_INDIRECT_GPU_ARGS=unset:")
        else()
            set_property(TEST ${agcIndirectArgsTest} APPEND PROPERTY ENVIRONMENT_MODIFICATION "APS5_PIPELINED_DRAWS=unset:" "APS5_ARCHB_PIPE_INDIRECT_GPU_ARGS=set:1")
        endif()
        if(WIN32)
            set_property(TEST ${agcIndirectArgsTest} APPEND PROPERTY ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
        endif()
    endforeach()
    foreach(agcSlicedMode IN ITEMS outside_kept inside_drain outside_off)
        set(agcSlicedTest agc_driver_pipe_q0_sliced_depth_${agcSlicedMode})
        if(agcSlicedMode MATCHES "^inside")
            add_test(NAME ${agcSlicedTest} COMMAND agc_driver_pipelined_indirect_draw_tests --sliced-depth-inside)
        else()
            add_test(NAME ${agcSlicedTest} COMMAND agc_driver_pipelined_indirect_draw_tests --sliced-depth-outside)
        endif()
        set_tests_properties(${agcSlicedTest} PROPERTIES ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1;APS5_ARCHB_PIPE_Q0_COMMITTER=1;APS5_ARCHB_PIPE_NARROW_DRAW_WRITES=1;APS5_PROFILE_DRAW=1" SKIP_RETURN_CODE 77 TIMEOUT 60 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
        if(agcSlicedMode STREQUAL "outside_off")
            set_property(TEST ${agcSlicedTest} APPEND PROPERTY ENVIRONMENT_MODIFICATION "APS5_PIPELINED_DRAWS=unset:" "APS5_ARCHB_PIPE_NARROW_SLICED_DEPTH=unset:")
        else()
            set_property(TEST ${agcSlicedTest} APPEND PROPERTY ENVIRONMENT_MODIFICATION "APS5_PIPELINED_DRAWS=unset:" "APS5_ARCHB_PIPE_NARROW_SLICED_DEPTH=set:1")
        endif()
        if(WIN32)
            set_property(TEST ${agcSlicedTest} APPEND PROPERTY ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
        endif()
    endforeach()
endif()
