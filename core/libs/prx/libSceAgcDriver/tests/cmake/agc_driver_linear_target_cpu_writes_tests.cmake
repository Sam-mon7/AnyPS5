if(BUILD_TESTING)
    foreach(targetPrelockMode IN ITEMS on off profile no_memo legacy clean_proof)
        set(targetPrelockTest agc_driver_draw_target_prelock_${targetPrelockMode})
        add_test(NAME ${targetPrelockTest} COMMAND agc_driver_linear_target_cpu_writes_tests --draw-target-prelock)
        set_tests_properties(${targetPrelockTest} PROPERTIES ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1;APS5_PIPELINED_DRAWS=0;APS5_ASSERT_GPU_LOCK=1" SKIP_RETURN_CODE 77 TIMEOUT 30 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
        if(targetPrelockMode STREQUAL "off")
            set_property(TEST ${targetPrelockTest} APPEND PROPERTY ENVIRONMENT_MODIFICATION "APS5_DRAW_TARGET_PRELOCK=unset:")
        else()
            set_property(TEST ${targetPrelockTest} APPEND PROPERTY ENVIRONMENT "APS5_DRAW_TARGET_PRELOCK=1")
        endif()
        if(targetPrelockMode STREQUAL "profile")
            set_property(TEST ${targetPrelockTest} APPEND PROPERTY ENVIRONMENT "APS5_PROFILE_DRAW=1")
        elseif(targetPrelockMode STREQUAL "no_memo")
            set_property(TEST ${targetPrelockTest} APPEND PROPERTY ENVIRONMENT "APS5_NO_COLLECT_MEMO=1")
        elseif(targetPrelockMode STREQUAL "legacy")
            set_property(TEST ${targetPrelockTest} APPEND PROPERTY ENVIRONMENT "APS5_NO_DRAW_PRELOCK=1")
        elseif(targetPrelockMode STREQUAL "clean_proof")
            set_property(TEST ${targetPrelockTest} APPEND PROPERTY ENVIRONMENT "APS5_TARGET_CLEAN_PROOF=1")
        endif()
        if(WIN32)
            set_property(TEST ${targetPrelockTest} APPEND PROPERTY ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
        endif()
    endforeach()
    foreach(drawPrelockMode IN ITEMS on off profile no_memo untrimmed)
        set(drawPrelockTest agc_driver_draw_prelock_${drawPrelockMode})
        add_test(NAME ${drawPrelockTest} COMMAND agc_driver_linear_target_cpu_writes_tests --draw-prelock)
        set_tests_properties(${drawPrelockTest} PROPERTIES ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1;APS5_PIPELINED_DRAWS=0;APS5_ASSERT_GPU_LOCK=1" SKIP_RETURN_CODE 77 TIMEOUT 30 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
        if(drawPrelockMode STREQUAL "off")
            set_property(TEST ${drawPrelockTest} APPEND PROPERTY ENVIRONMENT "APS5_NO_DRAW_PRELOCK=1")
        elseif(drawPrelockMode STREQUAL "profile")
            set_property(TEST ${drawPrelockTest} APPEND PROPERTY ENVIRONMENT "APS5_PROFILE_DRAW=1")
        elseif(drawPrelockMode STREQUAL "no_memo")
            set_property(TEST ${drawPrelockTest} APPEND PROPERTY ENVIRONMENT "APS5_NO_COLLECT_MEMO=1")
        elseif(drawPrelockMode STREQUAL "untrimmed")
            set_property(TEST ${drawPrelockTest} APPEND PROPERTY ENVIRONMENT "APS5_NO_DRAW_KEY_TRIM=1")
        endif()
        if(WIN32)
            set_tests_properties(${drawPrelockTest} PROPERTIES ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
        endif()
    endforeach()
endif()
