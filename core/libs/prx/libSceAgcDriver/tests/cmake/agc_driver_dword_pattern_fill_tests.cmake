if(BUILD_TESTING)
    foreach(fillKnownMode IN ITEMS on off verify profile)
        set(fillKnownTest agc_driver_fill_known_capture_${fillKnownMode})
        add_test(NAME ${fillKnownTest} COMMAND agc_driver_dword_pattern_fill_tests --known-capture)
        set_tests_properties(${fillKnownTest} PROPERTIES ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1;APS5_PIPELINED_DRAWS=0;APS5_NO_OPPORTUNISTIC_REAP=1;APS5_BATCH_CAP=0" SKIP_RETURN_CODE 77 TIMEOUT 30 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
        if(fillKnownMode STREQUAL "off")
            set_property(TEST ${fillKnownTest} APPEND PROPERTY ENVIRONMENT "APS5_NO_FILL_KNOWN_VALUES=1")
        elseif(fillKnownMode STREQUAL "verify")
            set_property(TEST ${fillKnownTest} APPEND PROPERTY ENVIRONMENT "APS5_VERIFY_KNOWN_VALUES=1")
        elseif(fillKnownMode STREQUAL "profile")
            set_property(TEST ${fillKnownTest} APPEND PROPERTY ENVIRONMENT "APS5_PROFILE_DRAW=1")
        endif()
        if(WIN32)
            set_tests_properties(${fillKnownTest} PROPERTIES ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
        endif()
    endforeach()
endif()

if(BUILD_TESTING)
    add_test(NAME agc_driver_dword_pattern_fill_translated COMMAND agc_driver_dword_pattern_fill_tests)
    set_tests_properties(agc_driver_dword_pattern_fill_translated PROPERTIES ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1;APS5_NO_FILL_HLE=1" SKIP_RETURN_CODE 77 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}" TIMEOUT 30)
    if(WIN32)
        set_tests_properties(agc_driver_dword_pattern_fill_translated PROPERTIES ENVIRONMENT_MODIFICATION
            "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
    endif()
endif()
