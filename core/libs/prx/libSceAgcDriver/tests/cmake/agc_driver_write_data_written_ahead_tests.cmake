if(BUILD_TESTING)
    foreach(captureLabelQueue IN ITEMS graphics compute)
        foreach(captureLabelMode IN ITEMS inline legacy no_queued pipeline)
            set(captureLabelTest agc_driver_capture_label_lock_batching_${captureLabelQueue}_${captureLabelMode})
            add_test(NAME ${captureLabelTest} COMMAND agc_driver_write_data_written_ahead_tests --${captureLabelQueue})
            set_tests_properties(${captureLabelTest} PROPERTIES ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1;APS5_PROFILE_DRAW=1;APS5_ASSERT_GPU_LOCK=1;APS5_PIPELINED_DRAWS=0;APS5_LABEL_FLUSH_US=60000000;APS5_BATCH_CAP=0" SKIP_RETURN_CODE 77 TIMEOUT 30 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
            if(captureLabelMode STREQUAL "legacy")
                set_property(TEST ${captureLabelTest} APPEND PROPERTY ENVIRONMENT "APS5_NO_CAPTURE_LABEL_LOCK_BATCHING=1")
            elseif(captureLabelMode STREQUAL "no_queued")
                set_property(TEST ${captureLabelTest} APPEND PROPERTY ENVIRONMENT "APS5_NO_QUEUED_LABELS=1")
            elseif(captureLabelMode STREQUAL "pipeline")
                set_property(TEST ${captureLabelTest} PROPERTY ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1;APS5_PROFILE_DRAW=1;APS5_ASSERT_GPU_LOCK=1;APS5_PIPELINED_DRAWS=1;APS5_LABEL_FLUSH_US=60000000;APS5_BATCH_CAP=0")
            endif()
            if(WIN32)
                set_tests_properties(${captureLabelTest} PROPERTIES ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
            endif()
        endforeach()
    endforeach()
    agc_add_draw_pipeline_test(agc_driver_write_data_written_ahead)
endif()
