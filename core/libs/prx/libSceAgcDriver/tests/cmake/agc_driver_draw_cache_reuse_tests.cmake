if(BUILD_TESTING)
    agc_add_draw_pipeline_test(agc_driver_draw_cache_reuse)
    agc_add_draw_pipeline_test(agc_driver_draw_data_hit_user_words)
    add_test(NAME agc_driver_draw_cache_reuse_off COMMAND agc_driver_draw_cache_reuse_tests)
    set_tests_properties(agc_driver_draw_cache_reuse_off PROPERTIES ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1;APS5_NO_GPL=1" SKIP_RETURN_CODE 77)
    add_test(NAME agc_driver_draw_cache_reuse_verify COMMAND agc_driver_draw_cache_reuse_tests)
    set_tests_properties(agc_driver_draw_cache_reuse_verify PROPERTIES ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1;APS5_VERIFY_DRAW_DATA_HITS=1" SKIP_RETURN_CODE 77)
    add_test(NAME agc_driver_draw_cache_reuse_entry_verify COMMAND agc_driver_draw_cache_reuse_tests)
    set_tests_properties(agc_driver_draw_cache_reuse_entry_verify PROPERTIES ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1;APS5_VERIFY_DRAW_ENTRIES=1" SKIP_RETURN_CODE 77 FAIL_REGULAR_EXPRESSION "FATAL:")
    if(WIN32)
        set_tests_properties(agc_driver_draw_cache_reuse_entry_verify PROPERTIES ENVIRONMENT_MODIFICATION
            "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
    endif()
    add_test(NAME agc_driver_draw_cache_reuse_inline COMMAND agc_driver_draw_cache_reuse_tests)
    set_tests_properties(agc_driver_draw_cache_reuse_inline PROPERTIES ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1;APS5_PIPELINED_DRAWS=0;APS5_VERIFY_DRAW_RECIPE=1;APS5_VERIFY_REGISTER_KEYS=1" SKIP_RETURN_CODE 77)
    add_test(NAME agc_driver_draw_cache_reuse_indirect COMMAND agc_driver_draw_cache_reuse_tests)
    set_tests_properties(agc_driver_draw_cache_reuse_indirect PROPERTIES ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1;APS5_DRAW_CACHE_INDIRECT=1;APS5_PROFILE_DRAW=1" SKIP_RETURN_CODE 77)
    set_tests_properties(agc_driver_draw_cache_reuse agc_driver_draw_cache_reuse_off agc_driver_draw_cache_reuse_verify agc_driver_draw_cache_reuse_inline agc_driver_draw_cache_reuse_indirect PROPERTIES FAIL_REGULAR_EXPRESSION "FATAL:")
    set_property(TEST agc_driver_draw_cache_reuse agc_driver_draw_cache_reuse_off APPEND PROPERTY ENVIRONMENT "APS5_VERIFY_DRAW_RECIPE=1" "APS5_VERIFY_REGISTER_KEYS=1")
    add_test(NAME agc_driver_draw_data_hit_user_words_verify COMMAND agc_driver_draw_data_hit_user_words_tests)
    set_tests_properties(agc_driver_draw_data_hit_user_words_verify PROPERTIES ENVIRONMENT "APS5_VERIFY_DRAW_DATA_HITS=1" SKIP_RETURN_CODE 77)
    add_test(NAME agc_driver_draw_data_hit_user_words_refresh COMMAND agc_driver_draw_data_hit_user_words_tests)
    set_tests_properties(agc_driver_draw_data_hit_user_words_refresh PROPERTIES ENVIRONMENT "APS5_DRAW_PIPELINE=1" SKIP_RETURN_CODE 77)
    if(WIN32)
        set_tests_properties(agc_driver_draw_cache_reuse_off agc_driver_draw_cache_reuse_verify agc_driver_draw_cache_reuse_inline agc_driver_draw_cache_reuse_indirect agc_driver_draw_data_hit_user_words_verify agc_driver_draw_data_hit_user_words_refresh PROPERTIES ENVIRONMENT_MODIFICATION
            "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
    endif()
    add_test(NAME agc_driver_tsharp_feedback_proof COMMAND agc_driver_draw_cache_reuse_tests --tsharp-proof)
    set_tests_properties(agc_driver_tsharp_feedback_proof PROPERTIES TIMEOUT 30)
    if(WIN32)
        set_tests_properties(agc_driver_tsharp_feedback_proof PROPERTIES ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
    endif()
    foreach(feedbackPath memory user refused)
        set(feedbackTest agc_driver_tsharp_feedback_cached_${feedbackPath})
        add_test(NAME ${feedbackTest} COMMAND agc_driver_draw_cache_reuse_tests --tsharp-cached-${feedbackPath})
        set_tests_properties(${feedbackTest} PROPERTIES TIMEOUT 30 ENVIRONMENT "APS5_VERIFY_TSHARP_MASK=1")
        if(WIN32)
            set_tests_properties(${feedbackTest} PROPERTIES ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
        endif()
    endforeach()
    foreach(feedbackPath draw_memory draw_user dispatch_memory dispatch_user)
        foreach(feedbackMode off on verify toggle no_register_key no_user_data_hits entry_verify)
            if(feedbackPath MATCHES "^dispatch" AND feedbackMode MATCHES "^(no_register_key|no_user_data_hits|entry_verify)$")
                continue()
            endif()
            set(feedbackTest agc_driver_tsharp_feedback_${feedbackPath}_${feedbackMode})
            add_test(NAME ${feedbackTest} COMMAND agc_driver_draw_cache_reuse_tests --tsharp-${feedbackPath}_${feedbackMode})
            set_tests_properties(${feedbackTest} PROPERTIES TIMEOUT 30 SKIP_RETURN_CODE 77 ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1")
            if(feedbackMode STREQUAL "off")
                set_property(TEST ${feedbackTest} APPEND PROPERTY ENVIRONMENT "APS5_NO_TSHARP_FEEDBACK_MASK=1")
            elseif(feedbackMode STREQUAL "no_register_key")
                set_property(TEST ${feedbackTest} APPEND PROPERTY ENVIRONMENT "APS5_NO_DRAW_KEY=1")
            elseif(feedbackMode STREQUAL "entry_verify")
                set_property(TEST ${feedbackTest} APPEND PROPERTY ENVIRONMENT "APS5_VERIFY_DRAW_ENTRIES=1")
            elseif(feedbackMode STREQUAL "no_user_data_hits")
                set_property(TEST ${feedbackTest} APPEND PROPERTY ENVIRONMENT "APS5_NO_DRAW_DATA_HITS=1")
            elseif(feedbackMode STREQUAL "verify")
                set_property(TEST ${feedbackTest} APPEND PROPERTY ENVIRONMENT "APS5_VERIFY_DRAW_DATA_HITS=1;APS5_VERIFY_DATA_HITS=1;APS5_VERIFY_TSHARP_MASK=1")
            endif()
            if(WIN32)
                set_tests_properties(${feedbackTest} PROPERTIES ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
            endif()
        endforeach()
    endforeach()
endif()
