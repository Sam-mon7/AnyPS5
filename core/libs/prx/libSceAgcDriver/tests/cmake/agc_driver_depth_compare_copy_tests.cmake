if(BUILD_TESTING)
    foreach(agcGpuArrayMode IN ITEMS on off verify cpu queued shadow)
        set(agcGpuArrayArgument ${agcGpuArrayMode})
        if(agcGpuArrayMode STREQUAL "verify")
            set(agcGpuArrayArgument on)
        endif()
        set(agcGpuArrayTest agc_archb_sampled_array_gpu_${agcGpuArrayMode})
        add_test(NAME ${agcGpuArrayTest} COMMAND agc_driver_depth_compare_copy_tests --gpu-array ${agcGpuArrayArgument})
        set_tests_properties(${agcGpuArrayTest} PROPERTIES ENVIRONMENT "APS5_ARCHB_FIX_PARTIAL_SNAPSHOT=1;APS5_ARCHB_FIX_SAMPLED_ARRAY_GPU=1;APS5_ARCHB_WT_FAULT=1;APS5_ARCHB_WT_FAULT_CONSUMERS=1" SKIP_RETURN_CODE 77 TIMEOUT 30)
        if(agcGpuArrayMode STREQUAL "off")
            set_property(TEST ${agcGpuArrayTest} APPEND PROPERTY ENVIRONMENT "APS5_ARCHB_FIX_SAMPLED_ARRAY_GPU=0")
        elseif(agcGpuArrayMode STREQUAL "verify")
            set_property(TEST ${agcGpuArrayTest} APPEND PROPERTY ENVIRONMENT "APS5_ARCHB_FIX_SAMPLED_ARRAY_GPU_VERIFY=1")
        elseif(agcGpuArrayMode STREQUAL "shadow")
            set_property(TEST ${agcGpuArrayTest} APPEND PROPERTY ENVIRONMENT "APS5_ARCHB_LAZY_SHADOW_PUBLISH=1;APS5_ARCHB_C_LAZY_PUBLISH=1")
        endif()
        if(WIN32)
            set_tests_properties(${agcGpuArrayTest} PROPERTIES ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
        endif()
    endforeach()
endif()

if(BUILD_TESTING)
    foreach(agcDepthArrayMode IN ITEMS on off verify cpu pending cold htile changed-htile queued toggle partial stale-cpu)
        set(agcDepthArrayTest agc_archb_depth_array_gpu_${agcDepthArrayMode})
        add_test(NAME ${agcDepthArrayTest} COMMAND agc_driver_depth_compare_copy_tests --depth-array ${agcDepthArrayMode})
        set_tests_properties(${agcDepthArrayTest} PROPERTIES ENVIRONMENT "APS5_ARCHB_FIX_PARTIAL_SNAPSHOT=1;APS5_ARCHB_FIX_SAMPLED_ARRAY_GPU=1;APS5_ARCHB_WT_FAULT=1;APS5_ARCHB_WT_FAULT_CONSUMERS=1;APS5_ARCHB_DEPTH_ARRAY_GPU=1" SKIP_RETURN_CODE 77 TIMEOUT 30)
        if(agcDepthArrayMode STREQUAL "off")
            set_property(TEST ${agcDepthArrayTest} APPEND PROPERTY ENVIRONMENT "APS5_ARCHB_DEPTH_ARRAY_GPU=0")
        elseif(agcDepthArrayMode STREQUAL "toggle")
            set_property(TEST ${agcDepthArrayTest} APPEND PROPERTY ENVIRONMENT "APS5_ARCHB_GATE_RUN=1")
        elseif(agcDepthArrayMode STREQUAL "verify")
            set_property(TEST ${agcDepthArrayTest} APPEND PROPERTY ENVIRONMENT "APS5_VERIFY_DEPTH_ARRAY_GPU=1;APS5_VERIFY_DEPTH_ARRAY_GPU_EVERY=1")
        endif()
        if(WIN32)
            set_tests_properties(${agcDepthArrayTest} PROPERTIES ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
        endif()
    endforeach()
endif()
