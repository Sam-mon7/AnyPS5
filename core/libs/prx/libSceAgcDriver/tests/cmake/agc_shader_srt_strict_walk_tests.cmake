if(BUILD_TESTING)
    foreach(strictWalkMode IN ITEMS 0 1 disabled)
        set(strictWalkTest agc_shader_srt_strict_walk_${strictWalkMode})
        add_test(NAME ${strictWalkTest} COMMAND agc_shader_memory_tests --srt-strict-walk)
        set_tests_properties(${strictWalkTest} PROPERTIES ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1" WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}" TIMEOUT 30)
        if(strictWalkMode STREQUAL "disabled")
            set_property(TEST ${strictWalkTest} APPEND PROPERTY ENVIRONMENT "APS5_SRT_FAST_WALK=0;APS5_NO_SRT_TAPE=1")
        else()
            set_property(TEST ${strictWalkTest} APPEND PROPERTY ENVIRONMENT "APS5_SRT_FAST_WALK=${strictWalkMode}")
        endif()
        if(WIN32)
            set_property(TEST ${strictWalkTest} APPEND PROPERTY ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
        endif()
    endforeach()
endif()
