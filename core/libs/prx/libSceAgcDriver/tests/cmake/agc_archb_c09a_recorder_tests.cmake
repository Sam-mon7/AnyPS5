if(BUILD_TESTING)
    add_test_executable(agc_archb_c09a_recorder_tests tests/ArchBRecorder.cpp
        Execution/src/ArchB/Recorder.cpp Execution/src/ArchB/CheapClock.cpp Execution/src/HostAllocator.cpp Execution/src/PerformanceTraceThread.cpp)
    target_include_directories(agc_archb_c09a_recorder_tests PRIVATE ${LIBS_INCLUDE_DIR} ${CMAKE_CURRENT_BINARY_DIR}/generated)
    target_link_libraries(agc_archb_c09a_recorder_tests PRIVATE libc)
    configure_windows_unwind(agc_archb_c09a_recorder_tests)
    if(WIN32 AND CMAKE_CXX_COMPILER_ID STREQUAL "GNU" AND CMAKE_SYSTEM_PROCESSOR MATCHES "^(AMD64|amd64|x86_64)$")
        target_compile_definitions(agc_archb_c09a_recorder_tests PRIVATE ARCHB_TEST_EMUTLS=1)
        target_link_options(agc_archb_c09a_recorder_tests PRIVATE "-Wl,--wrap=__emutls_get_address")
    endif()
    foreach(recorderCase IN ITEMS reconciles no_path_change toggle_interval_tagged shader_table_overflow hot_thread_state memory_access_thread_state)
        add_test(NAME agc_archb_c09a_recorder_${recorderCase} COMMAND agc_archb_c09a_recorder_tests ${recorderCase})
        set_tests_properties(agc_archb_c09a_recorder_${recorderCase} PROPERTIES TIMEOUT 30)
        if(WIN32)
            set_tests_properties(agc_archb_c09a_recorder_${recorderCase} PROPERTIES ENVIRONMENT_MODIFICATION
                "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
        endif()
    endforeach()
endif()

