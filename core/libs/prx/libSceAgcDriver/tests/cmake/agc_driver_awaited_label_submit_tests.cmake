if(BUILD_TESTING)
    add_test(NAME agc_driver_awaited_label_submit_off COMMAND agc_driver_awaited_label_submit_tests)
    add_test(NAME agc_driver_awaited_label_submit_locked COMMAND agc_driver_awaited_label_submit_tests)
    add_test(NAME agc_driver_awaited_label_submit_profile COMMAND agc_driver_awaited_label_submit_tests)
    foreach(labelStateMode IN ITEMS on off no_table no_submit profile)
        set(labelStateTest agc_driver_label_state_batching_${labelStateMode})
        add_test(NAME ${labelStateTest} COMMAND agc_driver_awaited_label_submit_tests --state-batching)
        set_tests_properties(${labelStateTest} PROPERTIES
            ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1;APS5_LABEL_FLUSH_US=1000000" SKIP_RETURN_CODE 77 TIMEOUT 30 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
        if(labelStateMode STREQUAL "off")
            set_property(TEST ${labelStateTest} APPEND PROPERTY ENVIRONMENT "APS5_NO_LABEL_STATE_BATCHING=1")
        elseif(labelStateMode STREQUAL "no_table")
            set_property(TEST ${labelStateTest} APPEND PROPERTY ENVIRONMENT "APS5_NO_QUEUED_LABELS=1")
        elseif(labelStateMode STREQUAL "no_submit")
            set_property(TEST ${labelStateTest} APPEND PROPERTY ENVIRONMENT "APS5_NO_LABEL_BATCH_SUBMIT=1")
        elseif(labelStateMode STREQUAL "profile")
            set_property(TEST ${labelStateTest} APPEND PROPERTY ENVIRONMENT "APS5_PROFILE_DRAW=1")
        endif()
        if(WIN32)
            set_tests_properties(${labelStateTest} PROPERTIES ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
        endif()
    endforeach()
    foreach(awaitedFlushMode IN ITEMS on off profile)
        add_test(NAME agc_driver_awaited_label_flush_${awaitedFlushMode} COMMAND agc_driver_awaited_label_submit_tests --producer)
        set_tests_properties(agc_driver_awaited_label_flush_${awaitedFlushMode} PROPERTIES
            ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1" SKIP_RETURN_CODE 77 TIMEOUT 30 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
        if(awaitedFlushMode STREQUAL "off")
            set_property(TEST agc_driver_awaited_label_flush_${awaitedFlushMode} APPEND PROPERTY ENVIRONMENT "APS5_NO_AWAITED_LABEL_FLUSH=1")
        elseif(awaitedFlushMode STREQUAL "profile")
            set_property(TEST agc_driver_awaited_label_flush_${awaitedFlushMode} APPEND PROPERTY ENVIRONMENT "APS5_PROFILE_DRAW=1")
        endif()
        if(WIN32)
            set_tests_properties(agc_driver_awaited_label_flush_${awaitedFlushMode} PROPERTIES
                ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
        endif()
    endforeach()
    foreach(awaitedEarlyMode IN ITEMS on off)
        add_test(NAME agc_archc_label_awaited_early_${awaitedEarlyMode} COMMAND agc_driver_awaited_label_submit_tests --awaited-early)
        set_tests_properties(agc_archc_label_awaited_early_${awaitedEarlyMode} PROPERTIES
            ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1;APS5_LABEL_FLUSH_US=1000000" SKIP_RETURN_CODE 77 TIMEOUT 30 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
        if(awaitedEarlyMode STREQUAL "on")
            set_property(TEST agc_archc_label_awaited_early_${awaitedEarlyMode} APPEND PROPERTY ENVIRONMENT "APS5_ARCHB_C_LABEL_AWAITED_EARLY=1;APS5_ARCHB_C_LABEL_AWAITED_EARLY_VERIFY=0")
        else()
            set_property(TEST agc_archc_label_awaited_early_${awaitedEarlyMode} APPEND PROPERTY ENVIRONMENT "APS5_ARCHB_C_LABEL_AWAITED_EARLY=0")
        endif()
        if(WIN32)
            set_tests_properties(agc_archc_label_awaited_early_${awaitedEarlyMode} PROPERTIES
                ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
        endif()
    endforeach()
    foreach(labelWakeMode IN ITEMS on off verify)
        add_test(NAME agc_archc_label_wake_${labelWakeMode} COMMAND agc_driver_awaited_label_submit_tests --label-wake)
        set_tests_properties(agc_archc_label_wake_${labelWakeMode} PROPERTIES
            ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1" SKIP_RETURN_CODE 77 TIMEOUT 30 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
        if(labelWakeMode STREQUAL "on")
            set_property(TEST agc_archc_label_wake_${labelWakeMode} APPEND PROPERTY ENVIRONMENT "APS5_ARCHB_C_LABEL_WAKE=1;APS5_ARCHB_C_LABEL_WAKE_VERIFY=0")
        elseif(labelWakeMode STREQUAL "verify")
            set_property(TEST agc_archc_label_wake_${labelWakeMode} APPEND PROPERTY ENVIRONMENT "APS5_ARCHB_C_LABEL_WAKE=1;APS5_ARCHB_C_LABEL_WAKE_VERIFY=1")
        else()
            set_property(TEST agc_archc_label_wake_${labelWakeMode} APPEND PROPERTY ENVIRONMENT "APS5_ARCHB_C_LABEL_WAKE=0")
        endif()
        if(WIN32)
            set_tests_properties(agc_archc_label_wake_${labelWakeMode} PROPERTIES
                ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
        endif()
    endforeach()
    add_test(NAME agc_driver_wait_label_profile_enabled COMMAND agc_driver_wait_label_profile_tests)
    set_tests_properties(agc_driver_awaited_label_submit agc_driver_wait_label_profile PROPERTIES TIMEOUT 30)
    set_tests_properties(agc_driver_awaited_label_submit_off PROPERTIES ENVIRONMENT "APS5_NO_WAIT_LABEL_SUBMIT=1;ANYPS5_NO_SHADER_CACHE=1")
    set_tests_properties(agc_driver_awaited_label_submit_locked PROPERTIES ENVIRONMENT "APS5_WAIT_LOCK=1;ANYPS5_NO_SHADER_CACHE=1")
    set_tests_properties(agc_driver_awaited_label_submit_profile agc_driver_wait_label_profile_enabled PROPERTIES ENVIRONMENT "APS5_PROFILE_DRAW=1;ANYPS5_NO_SHADER_CACHE=1")
    set_tests_properties(agc_driver_wait_label_profile_enabled PROPERTIES PASS_REGULAR_EXPRESSION "entry-last-known=\\{queue=0x38 packet=WRITE_DATA.*end=recorder.*record-to-seen")
    set_tests_properties(agc_driver_awaited_label_submit_off agc_driver_awaited_label_submit_locked agc_driver_awaited_label_submit_profile agc_driver_wait_label_profile_enabled
        PROPERTIES SKIP_RETURN_CODE 77 TIMEOUT 30 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
    if(WIN32)
        set_tests_properties(agc_driver_awaited_label_submit_off agc_driver_awaited_label_submit_locked agc_driver_awaited_label_submit_profile agc_driver_wait_label_profile_enabled
            PROPERTIES ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
    endif()
endif()
