if(BUILD_TESTING)
    set(gatherShadowEnvironment "ANYPS5_NO_SHADER_CACHE=1;APS5_ARCHB_DISPATCH_GATHER_SHADOW=1;APS5_DISPATCH_GATHER_SHADOW_STRICT=1;APS5_ARCHB_RECORDER=1")
    set_tests_properties(agc_driver_dispatch_gather_shadow PROPERTIES ENVIRONMENT "${gatherShadowEnvironment};APS5_PIPELINED_DRAWS=0" TIMEOUT 30 FAIL_REGULAR_EXPRESSION "FATAL:;VUID-")
    foreach(gatherShadowCase IN ITEMS control pending-parent pending-pointer-parent guarded-fault-nested moved-pointer-root moved-control-root guarded-inactive guarded-unmapped bda-address fault-only ahead ahead-cold ahead-cached ahead-fault-only fallback serial-race structural unmapped clamp indirect toggle callee)
        string(REPLACE "-" "_" gatherShadowSuffix ${gatherShadowCase})
        set(gatherShadowTest agc_driver_dispatch_gather_shadow_${gatherShadowSuffix})
        add_test(NAME ${gatherShadowTest} COMMAND agc_driver_dispatch_gather_shadow_tests --${gatherShadowCase})
        set_tests_properties(${gatherShadowTest} PROPERTIES ENVIRONMENT "${gatherShadowEnvironment};APS5_PIPELINED_DRAWS=0" TIMEOUT 30 SKIP_RETURN_CODE 77 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}" FAIL_REGULAR_EXPRESSION "FATAL:;VUID-")
        if(gatherShadowCase STREQUAL "indirect")
            set_property(TEST ${gatherShadowTest} APPEND PROPERTY ENVIRONMENT "APS5_NO_GPU_INDIRECT=1")
        endif()
        if(WIN32)
            set_tests_properties(${gatherShadowTest} PROPERTIES ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
        endif()
    endforeach()
    add_test(NAME agc_driver_dispatch_gather_shadow_queued COMMAND agc_driver_dispatch_gather_shadow_tests)
    set_tests_properties(agc_driver_dispatch_gather_shadow_queued PROPERTIES ENVIRONMENT "${gatherShadowEnvironment};APS5_ARCHB_PIPE_Q0_COMMITTER=1" TIMEOUT 30 SKIP_RETURN_CODE 77 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}" FAIL_REGULAR_EXPRESSION "FATAL:;VUID-")
    set_property(TEST agc_driver_dispatch_gather_shadow_queued APPEND PROPERTY ENVIRONMENT_MODIFICATION "APS5_PIPELINED_DRAWS=unset:")
    add_test(NAME agc_driver_dispatch_gather_shadow_pending_parent_queued COMMAND agc_driver_dispatch_gather_shadow_tests --pending-parent)
    set_tests_properties(agc_driver_dispatch_gather_shadow_pending_parent_queued PROPERTIES ENVIRONMENT "${gatherShadowEnvironment};APS5_ARCHB_PIPE_Q0_COMMITTER=1" TIMEOUT 30 SKIP_RETURN_CODE 77 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}" FAIL_REGULAR_EXPRESSION "FATAL:;VUID-")
    set_property(TEST agc_driver_dispatch_gather_shadow_pending_parent_queued APPEND PROPERTY ENVIRONMENT_MODIFICATION "APS5_PIPELINED_DRAWS=unset:")
    add_test(NAME agc_driver_dispatch_gather_shadow_pending_pointer_parent_queued COMMAND agc_driver_dispatch_gather_shadow_tests --pending-pointer-parent)
    set_tests_properties(agc_driver_dispatch_gather_shadow_pending_pointer_parent_queued PROPERTIES ENVIRONMENT "${gatherShadowEnvironment};APS5_ARCHB_PIPE_Q0_COMMITTER=1" TIMEOUT 30 SKIP_RETURN_CODE 77 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}" FAIL_REGULAR_EXPRESSION "FATAL:;VUID-")
    set_property(TEST agc_driver_dispatch_gather_shadow_pending_pointer_parent_queued APPEND PROPERTY ENVIRONMENT_MODIFICATION "APS5_PIPELINED_DRAWS=unset:")
    foreach(gatherShadowOff IN ITEMS default off clamp_off)
        set(gatherShadowTest agc_driver_dispatch_gather_shadow_${gatherShadowOff})
        if(gatherShadowOff STREQUAL "clamp_off")
            add_test(NAME ${gatherShadowTest} COMMAND agc_driver_dispatch_gather_shadow_tests --clamp-off)
        else()
            add_test(NAME ${gatherShadowTest} COMMAND agc_driver_dispatch_gather_shadow_tests --off)
        endif()
        set_tests_properties(${gatherShadowTest} PROPERTIES ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1;APS5_PIPELINED_DRAWS=0;APS5_ARCHB_DISPATCH_GATHER_SHADOW=0" TIMEOUT 30 SKIP_RETURN_CODE 77 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}" FAIL_REGULAR_EXPRESSION "FATAL:;VUID-")
        if(gatherShadowOff STREQUAL "default")
            set_property(TEST ${gatherShadowTest} APPEND PROPERTY ENVIRONMENT_MODIFICATION "APS5_ARCHB_DISPATCH_GATHER_SHADOW=unset:")
        endif()
        if(WIN32)
            set_property(TEST ${gatherShadowTest} APPEND PROPERTY ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
        endif()
    endforeach()
    add_test(NAME agc_driver_dispatch_gather_shadow_strict_missing COMMAND agc_driver_dispatch_gather_shadow_tests)
    set_tests_properties(agc_driver_dispatch_gather_shadow_strict_missing PROPERTIES ENVIRONMENT "APS5_ARCHB_DISPATCH_GATHER_SHADOW=1" ENVIRONMENT_MODIFICATION "APS5_DISPATCH_GATHER_SHADOW_STRICT=unset:" WILL_FAIL TRUE TIMEOUT 30 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
    add_test(NAME agc_driver_dispatch_gather_shadow_activation_missing COMMAND agc_driver_dispatch_gather_shadow_tests)
    set_tests_properties(agc_driver_dispatch_gather_shadow_activation_missing PROPERTIES ENVIRONMENT "APS5_ARCHB_DISPATCH_GATHER_SHADOW=0;APS5_DISPATCH_GATHER_SHADOW_STRICT=1" WILL_FAIL TRUE TIMEOUT 30 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
    if(WIN32)
        set_property(TEST agc_driver_dispatch_gather_shadow_queued agc_driver_dispatch_gather_shadow_pending_parent_queued agc_driver_dispatch_gather_shadow_pending_pointer_parent_queued agc_driver_dispatch_gather_shadow_strict_missing agc_driver_dispatch_gather_shadow_activation_missing APPEND PROPERTY ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
    endif()
endif()
