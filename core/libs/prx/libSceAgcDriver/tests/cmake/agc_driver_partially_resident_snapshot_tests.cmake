                        string(APPEND agcResidencyEnvironment ";APS5_ARCHB_PIPE_RESOLVE_PROOFS=1")
                    elseif(agcResidencyProof STREQUAL "epoch" OR agcResidencyProof STREQUAL "epoch_off")
                        string(APPEND agcResidencyEnvironment ";APS5_RESOURCE_EPOCH_PROOFS=1")
                    elseif(agcResidencyProof STREQUAL "pipeline")
                        string(APPEND agcResidencyEnvironment ";APS5_DRAW_PIPELINE=1")
