if(BUILD_TESTING)
    add_test(NAME agc_driver_linear_readback_label_off COMMAND agc_driver_linear_readback_label_tests)
    set_tests_properties(agc_driver_linear_readback_label_off PROPERTIES ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1;APS5_NO_LABEL_READBACK_STORE=1" SKIP_RETURN_CODE 77 PASS_REGULAR_EXPRESSION "read after the label" TIMEOUT 60)
    foreach(labelWaitMode unlocked locked no_timeline)
        set(labelWaitTest agc_driver_readback_label_waits_${labelWaitMode})
        add_test(NAME ${labelWaitTest} COMMAND agc_driver_linear_readback_label_tests --deferred-label)
        set_tests_properties(${labelWaitTest} PROPERTIES ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1;APS5_PIPELINED_DRAWS=0;APS5_LABEL_FLUSH_US=0" SKIP_RETURN_CODE 77 TIMEOUT 30)
        if(labelWaitMode STREQUAL "locked")
            set_property(TEST ${labelWaitTest} APPEND PROPERTY ENVIRONMENT_MODIFICATION "APS5_UNLOCKED_LABEL_WAITS=unset:")
        else()
            set_property(TEST ${labelWaitTest} APPEND PROPERTY ENVIRONMENT "APS5_UNLOCKED_LABEL_WAITS=1")
        endif()
        if(labelWaitMode STREQUAL "no_timeline")
            set_property(TEST ${labelWaitTest} APPEND PROPERTY ENVIRONMENT "APS5_NO_TIMELINE=1")
        endif()
        if(WIN32)
            set_property(TEST ${labelWaitTest} APPEND PROPERTY ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
        endif()
    endforeach()
    if(WIN32)
        set_tests_properties(agc_driver_linear_readback_label_off PROPERTIES ENVIRONMENT_MODIFICATION
            "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
    endif()
endif()
