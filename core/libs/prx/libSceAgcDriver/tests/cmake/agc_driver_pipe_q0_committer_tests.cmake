if(BUILD_TESTING)
    foreach(agcPipeQ0Mode IN ITEMS sample_on sample_off sample_env transition keep_registers registers_drain resolve_split resolve_pool resolve_conflict)
        string(REPLACE "_" "-" agcPipeQ0Argument "${agcPipeQ0Mode}")
        add_test(NAME agc_driver_pipe_q0_${agcPipeQ0Mode} COMMAND agc_driver_pipe_q0_committer_tests --${agcPipeQ0Argument})
        set_tests_properties(agc_driver_pipe_q0_${agcPipeQ0Mode} PROPERTIES ENVIRONMENT "ANYPS5_NO_SHADER_CACHE=1" SKIP_RETURN_CODE 77 TIMEOUT 60 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
        if(agcPipeQ0Mode STREQUAL "sample_on")
            set_property(TEST agc_driver_pipe_q0_${agcPipeQ0Mode} APPEND PROPERTY ENVIRONMENT_MODIFICATION "APS5_PIPELINED_DRAWS=unset:" "APS5_ARCHB_PIPE_Q0_COMMITTER=set:1")
        elseif(agcPipeQ0Mode STREQUAL "sample_off")
            set_property(TEST agc_driver_pipe_q0_${agcPipeQ0Mode} APPEND PROPERTY ENVIRONMENT_MODIFICATION "APS5_PIPELINED_DRAWS=unset:" "APS5_ARCHB_PIPE_Q0_COMMITTER=unset:")
        elseif(agcPipeQ0Mode STREQUAL "sample_env")
            set_property(TEST agc_driver_pipe_q0_${agcPipeQ0Mode} APPEND PROPERTY ENVIRONMENT_MODIFICATION "APS5_PIPELINED_DRAWS=set:0" "APS5_ARCHB_PIPE_Q0_COMMITTER=set:1")
        elseif(agcPipeQ0Mode STREQUAL "keep_registers")
            set_property(TEST agc_driver_pipe_q0_${agcPipeQ0Mode} APPEND PROPERTY ENVIRONMENT_MODIFICATION "APS5_PIPELINED_DRAWS=unset:" "APS5_ARCHB_PIPE_Q0_COMMITTER=set:1" "APS5_ARCHB_PIPE_KEEP_INDIRECT_REGS=set:1")
        elseif(agcPipeQ0Mode STREQUAL "registers_drain")
            set_property(TEST agc_driver_pipe_q0_${agcPipeQ0Mode} APPEND PROPERTY ENVIRONMENT_MODIFICATION "APS5_PIPELINED_DRAWS=unset:" "APS5_ARCHB_PIPE_Q0_COMMITTER=set:1" "APS5_ARCHB_PIPE_KEEP_INDIRECT_REGS=unset:")
        elseif(agcPipeQ0Mode STREQUAL "resolve_split")
            set_property(TEST agc_driver_pipe_q0_${agcPipeQ0Mode} APPEND PROPERTY ENVIRONMENT_MODIFICATION "APS5_PIPELINED_DRAWS=unset:" "APS5_ARCHB_PIPE_Q0_COMMITTER=set:1" "APS5_ARCHB_PIPE_RESOLVE_SPLIT=set:1" "APS5_ARCHB_PIPE_RESOLVE_POOL=unset:" "APS5_ARCHB_PIPE_RESOLVE_SPLIT_VERIFY=unset:")
        elseif(agcPipeQ0Mode MATCHES "^resolve_")
            set_property(TEST agc_driver_pipe_q0_${agcPipeQ0Mode} APPEND PROPERTY ENVIRONMENT_MODIFICATION "APS5_PIPELINED_DRAWS=unset:" "APS5_ARCHB_PIPE_Q0_COMMITTER=set:1" "APS5_ARCHB_PIPE_RESOLVE_SPLIT=set:1" "APS5_ARCHB_PIPE_RESOLVE_POOL=set:1" "APS5_ARCHB_PIPE_RESOLVE_SPLIT_VERIFY=unset:")
        endif()
    endforeach()
    if(WIN32)
        foreach(agcPipeQ0Mode IN ITEMS sample_on sample_off sample_env transition keep_registers registers_drain resolve_split resolve_pool resolve_conflict)
            set_property(TEST agc_driver_pipe_q0_${agcPipeQ0Mode} APPEND PROPERTY ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
        endforeach()
    endif()
endif()
