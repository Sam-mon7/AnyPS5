set(capture "${DIRECTORY}/capture 'quoted' & $scene %APS5_HEADLESS_PIPELINE_CACHE% ! (1)")
file(MAKE_DIRECTORY "${DIRECTORY}")
file(WRITE "${DIRECTORY}/tool-output.log" "")
set(writerMode inspect_capture)
if(MODE STREQUAL "exit_watchdog")
    execute_process(COMMAND "${WRITER}" shutdown_watchdog "${capture}"
            RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 5)
    if(NOT result STREQUAL "3" OR NOT error MATCHES "shutdown did not finish within 50 ms; blocked on discarding queued submissions")
        message(FATAL_ERROR "shutdown watchdog failed: ${result}\n${output}\n${error}")
    endif()
    return()
endif()
if(MODE MATCHES "^exit_(.*)$")
    set(scenario "${CMAKE_MATCH_1}")
    if(scenario MATCHES "^(shutdown|profile|recorded_only|synthesize|delayed_release)$")
        set(scenario parked)
    endif()
    set(writerMode "exit_capture_${scenario}")
endif()
execute_process(COMMAND "${WRITER}" "${writerMode}" "${capture}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
if(NOT result STREQUAL "0")
    message(FATAL_ERROR "capture writer failed: ${result}\n${output}\n${error}")
endif()
if(NOT EXISTS "${capture}/calls.bin")
    message(FATAL_ERROR "capture path was not passed literally: ${capture}")
endif()

function(runTool expected)
    execute_process(COMMAND "${TOOL}" "${capture}" ${ARGN}
            RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
    file(APPEND "${DIRECTORY}/tool-output.log" "arguments: ${ARGN}\nresult: ${result}\n${output}\n${error}\n")
    string(REPLACE "\\" "/" error "${error}")
    if(NOT result STREQUAL "${expected}")
        message(FATAL_ERROR "agc_frame_replay ${ARGN}: expected ${expected}, got ${result}\n${output}\n${error}")
    endif()
    set(output "${output}" PARENT_SCOPE)
    set(error "${error}" PARENT_SCOPE)
endfunction()

function(requireContains text needle)
    string(FIND "${text}" "${needle}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "missing '${needle}' in:\n${text}")
    endif()
endfunction()

if(MODE MATCHES "^exit_")
    file(READ "${capture}/test-address.txt" address)
    set(dump "${DIRECTORY}/result.bin")
    file(REMOVE "${dump}")
    set(args --no-pace --cold-pipelines --dump "${address}:4:${dump}")
    if(scenario STREQUAL "parked" OR scenario STREQUAL "exception")
        list(APPEND args --parked-drain-ms 50)
        if(MODE STREQUAL "exit_synthesize")
        elseif(MODE STREQUAL "exit_delayed_release")
            list(APPEND args --release-after-ms 200)
        elseif(MODE STREQUAL "exit_recorded_only")
            list(APPEND args --no-synthesize)
        else()
            list(APPEND args --no-release --no-synthesize)
        endif()
        if(MODE STREQUAL "exit_profile")
            list(APPEND args --profile-draws "${DIRECTORY}/profile.jsonl")
        endif()
        if(MODE STREQUAL "exit_shutdown" OR scenario STREQUAL "exception")
            set(ENV{VK_LOADER_DEBUG} layer)
            set(ENV{VK_INSTANCE_LAYERS} VK_LAYER_KHRONOS_validation)
        endif()
        foreach(value IN ITEMS -1 1junk 9223372036854775807 18446744073709551616)
            runTool(2 --parked-drain-ms "${value}")
            requireContains("${error}" "usage: agc_frame_replay")
        endforeach()
        if(scenario STREQUAL "exception")
            runTool(2 ${args})
        elseif(MODE STREQUAL "exit_synthesize" OR MODE STREQUAL "exit_delayed_release")
            runTool(0 ${args})
            requireContains("${output}" "\"unfinished\":0")
        else()
            runTool(3 ${args})
            requireContains("${error}" "did not complete after the last captured call")
            requireContains("${error}" "blocked on 0x")
            requireContains("${output}" "\"unfinished\":2")
        endif()
        if(MODE STREQUAL "exit_shutdown" OR scenario STREQUAL "exception")
            requireContains("${error}" "Unloading layer library")
            if(NOT error MATCHES "Unloading layer library [^\r\n]*VkLayer_khronos_validation")
                message(FATAL_ERROR "the validation layer was not unloaded:\n${error}")
            endif()
        endif()
    else()
        if(scenario STREQUAL "before_first" OR scenario STREQUAL "inside_first" OR scenario STREQUAL "loop_before_first" OR scenario STREQUAL "snapshot_first")
            runTool(3 ${args})
            requireContains("${error}" "no whole frame")
            set(dropped 2)
            if(scenario STREQUAL "loop_before_first")
                set(dropped 3)
            elseif(scenario STREQUAL "snapshot_first")
                set(dropped 9)
            endif()
            requireContains("${error}" "replaying 0 whole frames; dropped ${dropped} trailing calls")
            if(output MATCHES "\"frames\"")
                message(FATAL_ERROR "an empty truncated capture reported replay frames: ${output}")
            endif()
        else()
            runTool(0 ${args})
            set(frames 1)
            set(dropped 0)
            if(scenario STREQUAL "inside_second")
                set(dropped 1)
            elseif(scenario STREQUAL "after_second")
                set(frames 2)
            elseif(scenario MATCHES "^memory_")
                set(dropped 6)
            endif()
            requireContains("${error}" "replaying ${frames} whole frames; dropped ${dropped} trailing calls")
            requireContains("${output}" "\"frames\":${frames},")
            file(READ "${dump}" data HEX)
            if(frames EQUAL 1 AND NOT data STREQUAL "78563412")
                message(FATAL_ERROR "a dropped call's memory was applied: ${data}")
            endif()
        endif()
    endif()
    if(error MATCHES "VUID-|was not found but was requested by env var VK_INSTANCE_LAYERS|shutdown did not finish")
        message(FATAL_ERROR "unclean replay shutdown:\n${error}")
    endif()
elseif(MODE STREQUAL "submits")
    runTool(0 --submits 1)
    requireContains("${output}" "#1 ordinal 5 submit thread 7 queue 0x42 serials 9/12 address 0x1000000001 dwords 27")
    requireContains("${output}" "@5 WAIT_REG_MEM function 3 space 1 address 0x9abcdef012345678 reference 0x10203040 mask 0xf0f0f0f0")
    requireContains("${output}" "@12 RELEASE_MEM 00000001 00000002 00000003 00000004 00000005 00000006 00000007")
    requireContains("${output}" "@20 WRITE_DATA 00000500 deadbeef 00000012 00001337")
    requireContains("${output}" "@25 (truncated packet: 5 dwords, 2 available)")
    requireContains("${output}" "packets: RELEASE_MEM x1 WAIT_REG_MEM x1 WRITE_DATA x1")
    if(output MATCHES "#2|ordinal 1 |reference 0x55667788|NOP|@1 WAIT_REG_MEM")
        message(FATAL_ERROR "listing included a later submission, prologue or payload packet:\n${output}")
    endif()
    runTool(0 --submits 2)
    requireContains("${output}" "#2 ordinal 7 submit")
    requireContains("${output}" "reference 0x55667788")
    runTool(0 --submits 4)
    requireContains("${output}" "#3 ordinal 11 flip")
    requireContains("${output}" "#4 ordinal 12 reserve-eop-flip")
    if(output MATCHES "#5")
        message(FATAL_ERROR "listing exceeded --submits 4:\n${output}")
    endif()
    runTool(0 --submits 8)
    requireContains("${output}" "#8 ordinal 16 submit")
    string(REGEX MATCHALL "command buffer not readable" unreadable "${output}")
    list(LENGTH unreadable count)
    if(NOT count EQUAL 3)
        message(FATAL_ERROR "missing unrecorded and overflowing buffer diagnostics:\n${output}")
    endif()
    foreach(value IN ITEMS 0 -1 +1 1junk 18446744073709551616)
        runTool(2 --submits "${value}")
        requireContains("${error}" "usage: agc_frame_replay")
    endforeach()
    runTool(2 --submits)
elseif(MODE STREQUAL "shader_output")
    runTool(0 --shaders)
    requireContains("${output}" "\"ordinal\":3,\"in_window\":false")
    requireContains("${output}" "\"ordinal\":8,\"in_window\":true")
    requireContains("${output}" "\"hash\":\"541dd60be6dc3e20\",\"copy\":2")
    requireContains("${output}" "\"hash\":\"b6df526defd638c2\",\"copy\":1")
    requireContains("${output}" "{\"registrations\":3,\"in_window\":2,\"distinct_code\":2,\"unreadable\":0}")
    set(binaries "${DIRECTORY}/shader code 'quoted' & $scene (2)")
    runTool(0 --cold-pipelines --shader-code "${binaries}")
    file(GLOB files "${binaries}/*.bin")
    list(LENGTH files count)
    if(NOT count EQUAL 2)
        message(FATAL_ERROR "expected two distinct shader binaries, got ${count}")
    endif()
    file(READ "${binaries}/type0-541dd60be6dc3e20.bin" first HEX)
    file(READ "${binaries}/type0-b6df526defd638c2.bin" second HEX)
    if(NOT first STREQUAL "0001020304050607ff800d0a27242600" OR NOT second STREQUAL "4201020304050607ff800d0a27242600")
        message(FATAL_ERROR "shader binaries differ from the bytes at registration: ${first}, ${second}")
    endif()
    set(blocked "${DIRECTORY}/blocked output 'quoted' & $scene (3)")
    set(blockedFile "${blocked}/type0-541dd60be6dc3e20.bin")
    file(MAKE_DIRECTORY "${blockedFile}")
    runTool(2 --shader-code "${blocked}")
    requireContains("${error}" "cannot open ${blockedFile}")
    if(output MATCHES "\"registrations\"")
        message(FATAL_ERROR "failed shader output reported success JSON:\n${output}")
    endif()
    if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
        set(full "${DIRECTORY}/full output")
        file(MAKE_DIRECTORY "${full}")
        set(fullFile "${full}/type0-541dd60be6dc3e20.bin")
        file(REMOVE "${fullFile}")
        file(CREATE_LINK /dev/full "${fullFile}" SYMBOLIC RESULT linked)
        if(NOT linked STREQUAL "0")
            message(FATAL_ERROR "cannot link /dev/full: ${linked}")
        endif()
        runTool(2 --shader-code "${full}")
        requireContains("${error}" "${fullFile}")
        if(NOT error MATCHES "cannot (write|flush|close)" OR output MATCHES "\"registrations\"")
            message(FATAL_ERROR "late shader output failure was not reported:\n${output}\n${error}")
        endif()
    endif()
elseif(MODE STREQUAL "profile_draws")
    runTool(2 --profile-draws)
    requireContains("${error}" "[--profile-draws <file>]")
    set(missing "${DIRECTORY}/missing 'quoted' & $scene (4)/draws.jsonl")
    file(REMOVE_RECURSE "${DIRECTORY}/missing 'quoted' & $scene (4)")
    runTool(2 --profile-draws "${missing}")
    requireContains("${error}" "cannot open ${missing}")
    if(output MATCHES "\"frames\"")
        message(FATAL_ERROR "a replay whose draw profile cannot be written reported frames:\n${output}")
    endif()
else()
    message(FATAL_ERROR "unknown inspection mode: ${MODE}")
endif()
