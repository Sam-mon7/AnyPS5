#version 450
layout(local_size_x = 1) in;
layout(set = 0, binding = 0, r32ui) readonly uniform uimage2D sourceImage;
layout(set = 0, binding = 1, r32ui) writeonly uniform uimage2D destinationImage;
layout(push_constant) uniform Update { uint delta; } update;
void main() { imageStore(destinationImage, ivec2(0), imageLoad(sourceImage, ivec2(0)) + uvec4(update.delta)); }
