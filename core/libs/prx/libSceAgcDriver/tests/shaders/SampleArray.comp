#version 450

layout(local_size_x = 1) in;
#if defined(MIP_CHAIN_1D)
layout(set = 0, binding = 0) uniform sampler1D source;
#elif defined(MIP_CHAIN_1DArray)
layout(set = 0, binding = 0) uniform sampler1DArray source;
#elif defined(MIP_CHAIN_3D)
layout(set = 0, binding = 0) uniform sampler3D source;
#else
layout(set = 0, binding = 0) uniform sampler2DArray source;
#endif
layout(set = 0, binding = 1, std430) buffer Result { vec4 texel; };
layout(push_constant) uniform Parameters { float lod; float layer; } parameters;

void main() {
#if defined(MIP_CHAIN_1D)
    texel = textureLod(source, 0.5, parameters.lod);
#elif defined(MIP_CHAIN_1DArray)
    texel = textureLod(source, vec2(0.5, parameters.layer), parameters.lod);
#else
    texel = textureLod(source, vec3(0.5, 0.5, parameters.layer), parameters.lod);
#endif
}
