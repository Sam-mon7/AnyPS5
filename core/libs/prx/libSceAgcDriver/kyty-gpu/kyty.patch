+void Swapchain::FinishCapture() {
+	m_capture_pending = false;
+	const bool rgba   = m_format == vk::Format::eR8G8B8A8Unorm || m_format == vk::Format::eR8G8B8A8Srgb;
+	KytyHostCaptureWrite(m_capture_path.c_str(), m_capture_mapped, m_extent.width, m_extent.height, rgba);
