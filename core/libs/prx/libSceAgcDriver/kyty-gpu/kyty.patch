+bool Swapchain::PrepareCapture() {
+	const uint64_t bytes = uint64_t {m_extent.width} * m_extent.height * 4u;
+	if (bytes == 0) {
+		return false;
+	}
+	if (m_capture_buffer != nullptr && m_capture_bytes == bytes) {
+		return true;
+	}
+	auto& graphics = m_window.graphic_ctx;
+	if (m_capture_buffer != nullptr) {
+		graphics.device.unmapMemory(m_capture_memory);
+		graphics.device.destroyBuffer(m_capture_buffer);
+		graphics.device.freeMemory(m_capture_memory);
+		m_capture_buffer = nullptr;
+		m_capture_memory = nullptr;
+	}
+	vk::BufferCreateInfo info {};
+	info.size        = bytes;
+	info.usage       = vk::BufferUsageFlagBits::eTransferDst;
+	info.sharingMode = vk::SharingMode::eExclusive;
+	if (graphics.device.createBuffer(&info, nullptr, &m_capture_buffer) != vk::Result::eSuccess) {
+		m_capture_buffer = nullptr;
+		return false;
+	}
+	vk::MemoryRequirements requirements {};
+	graphics.device.getBufferMemoryRequirements(m_capture_buffer, &requirements);
+	vk::PhysicalDeviceMemoryProperties properties {};
+	graphics.physical_device.getMemoryProperties(&properties);
+	const auto wanted = vk::MemoryPropertyFlagBits::eHostVisible | vk::MemoryPropertyFlagBits::eHostCoherent;
+	uint32_t   type   = properties.memoryTypeCount;
+	for (uint32_t i = 0; i < properties.memoryTypeCount; i++) {
+		if ((requirements.memoryTypeBits & (1u << i)) != 0 &&
+		    (properties.memoryTypes[i].propertyFlags & wanted) == wanted) {
+			type = i;
+			break;
+		}
+	}
+	vk::MemoryAllocateInfo allocate {};
+	allocate.allocationSize  = requirements.size;
+	allocate.memoryTypeIndex = type;
+	if (type == properties.memoryTypeCount ||
+	    graphics.device.allocateMemory(&allocate, nullptr, &m_capture_memory) != vk::Result::eSuccess ||
+	    graphics.device.bindBufferMemory(m_capture_buffer, m_capture_memory, 0) != vk::Result::eSuccess ||
+	    graphics.device.mapMemory(m_capture_memory, 0, bytes, {}, &m_capture_mapped) != vk::Result::eSuccess) {
+		graphics.device.destroyBuffer(m_capture_buffer);
+		if (m_capture_memory != nullptr) graphics.device.freeMemory(m_capture_memory);
+		m_capture_buffer = nullptr;
+		m_capture_memory = nullptr;
+		return false;
+	}
+	m_capture_bytes = bytes;
+	return true;
+}
+
+void Swapchain::FinishCapture() {
+	m_capture_pending = false;
+	const bool rgba   = m_format == vk::Format::eR8G8B8A8Unorm || m_format == vk::Format::eR8G8B8A8Srgb;
+	KytyHostCaptureWrite(m_capture_path.c_str(), m_capture_mapped, m_extent.width, m_extent.height, rgba);
+}
